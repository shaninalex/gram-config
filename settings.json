// Gram settings
//
// For information on how to configure Gram, see the Gram
// documentation: gram://docs/configuring-gram
//
// To see all of Gram's default settings without changing your
// custom settings, run `gram: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "vim_mode": true,
  "icon_theme": "Material Icon Theme",
  "autosave": "on_focus_change",
  "buffer_font_family": "Hack Nerd Font",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
    "blame": {
      "show_avatar": false,
    },
  },
  "node": {
    "allow_prettier_download": true,
    "allow_npm_install": true,
    "allow_binary_download": true,
  },
  "buffer_line_height": "standard",
  "lsp": {
    "vscode-css-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "ignore_system_version": true,
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "vtsls": {
      "binary": {
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "yaml-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "ignore_system_version": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "basedpyright": {
      "binary": {
        "enable_auto_updates": true,
        "ignore_system_version": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "ruff": {
      "binary": {
        "enable_auto_updates": true,
        "ignore_system_version": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "eslint": {
      "binary": {
        "allow_binary_download": true,
        "ignore_system_version": true,
        "enable_auto_updates": true,
      },
      "enable_lsp_tasks": true,
    },
    "gopls": {
      "binary": {
        "enable_auto_updates": true,
        "ignore_system_version": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "tailwindcss-language-server": {
      "binary": {
        "enable_auto_updates": true,
        "allow_binary_download": true,
        "ignore_system_version": true,
      },
      "enable_lsp_tasks": true,
    },
    "ols": {
      "binary": {
        "enable_auto_updates": true,
        "ignore_system_version": true,
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
  },
  "project_panel": {
    "folder_icons": true,
    "file_icons": true,
    "sticky_scroll": false,
  },
  "sticky_scroll": {
    "enabled": false,
  },
  "base_keymap": "JetBrains",
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "Melange Light",
    "dark": "One Dark",
  },
}
